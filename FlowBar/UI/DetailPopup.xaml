<Window x:Class="FlowBar.UI.DetailPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowBar"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Animated"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="Subtle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MenuSubtle}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
    </Style>
    <Style x:Key="Num" TargetType="TextBlock" BasedOn="{StaticResource Body}">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="TextAlignment" Value="Right"/>
    </Style>
  </Window.Resources>

  <Border x:Name="Card" Margin="16" CornerRadius="10" BorderThickness="1" Padding="16,14,16,10" Width="304"
          Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource MenuBorder}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.26"/>
    </Border.Effect>
    <StackPanel>
      <!-- header -->
      <Grid>
        <TextBlock Text="网速" FontSize="14" FontWeight="SemiBold" Style="{StaticResource Body}"/>
        <TextBlock x:Name="AdapterText" Style="{StaticResource Subtle}" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
      </Grid>

      <!-- current rates -->
      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="下载" Style="{StaticResource Subtle}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock x:Name="RxBig" Text="0" FontSize="24" FontFamily="Segoe UI" FontWeight="SemiBold" Style="{StaticResource Body}"/>
            <TextBlock x:Name="RxUnit" Text="KB/s" Style="{StaticResource Subtle}" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentTx}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="上传" Style="{StaticResource Subtle}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock x:Name="TxBig" Text="0" FontSize="24" FontFamily="Segoe UI" FontWeight="SemiBold" Style="{StaticResource Body}"/>
            <TextBlock x:Name="TxUnit" Text="KB/s" Style="{StaticResource Subtle}" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- sparkline -->
      <Grid Margin="0,10,0,0" Height="64">
        <Border CornerRadius="6" Background="{DynamicResource MenuHover}"/>
        <Canvas x:Name="Chart" ClipToBounds="True" Margin="1">
          <Polygon x:Name="RxFill" Fill="{DynamicResource Accent}" Opacity="0.14"/>
          <Polygon x:Name="TxFill" Fill="{DynamicResource AccentTx}" Opacity="0.14"/>
          <Polyline x:Name="RxLine" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
          <Polyline x:Name="TxLine" Stroke="{DynamicResource AccentTx}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
        </Canvas>
        <TextBlock x:Name="ChartMax" Style="{StaticResource Subtle}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,6,0"/>
        <TextBlock x:Name="ChartSpan" Style="{StaticResource Subtle}" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,2" Text="最近 2 分钟"/>
      </Grid>

      <!-- totals -->
      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="1" Text="下载" Style="{StaticResource Subtle}" TextAlignment="Right" Width="86"/>
        <TextBlock Grid.Column="2" Text="上传" Style="{StaticResource Subtle}" TextAlignment="Right" Width="86"/>
        <TextBlock Grid.Row="1" Text="今日" Style="{StaticResource Body}" Margin="0,3,0,0"/>
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TodayRx" Style="{StaticResource Num}" Margin="0,3,0,0"/>
        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TodayTx" Style="{StaticResource Num}" Margin="0,3,0,0"/>
        <TextBlock Grid.Row="2" Text="本月" Style="{StaticResource Body}" Margin="0,3,0,0"/>
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MonthRx" Style="{StaticResource Num}" Margin="0,3,0,0"/>
        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="MonthTx" Style="{StaticResource Num}" Margin="0,3,0,0"/>
        <TextBlock Grid.Row="3" Text="本次运行" Style="{StaticResource Body}" Margin="0,3,0,0"/>
        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SessRx" Style="{StaticResource Num}" Margin="0,3,0,0"/>
        <TextBlock Grid.Row="3" Grid.Column="2" x:Name="SessTx" Style="{StaticResource Num}" Margin="0,3,0,0"/>
      </Grid>

      <Border Height="1" Margin="0,12,0,8" Background="{DynamicResource MenuBorder}"/>

      <!-- adapters -->
      <TextBlock Text="统计网卡" Style="{StaticResource Subtle}" Margin="0,0,0,4"/>
      <StackPanel x:Name="AdapterList"/>

      <Border Height="1" Margin="0,8,0,4" Background="{DynamicResource MenuBorder}"/>

      <Grid>
        <TextBlock Text="右键小组件可调整外观与位置" Style="{StaticResource Subtle}" VerticalAlignment="Center"/>
        <Button x:Name="QuitButton" Content="退出" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" Margin="0,0,-10,0"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
